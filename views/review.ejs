<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Reviews</title>

  <link rel="stylesheet" href="/style.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
</head>
<body>
  <nav>
    <div class="logo">
      <h1>Shoe<span>s</span></h1>
    </div>

    <ul>
      <li><a href="index.ejs">Home</a></li>
      <li><a href="products.ejs">Products</a></li>
      <li><a href="about.ejs">About</a></li>
      <li><a href="review.ejs">Review</a></li>
      <li><a href="services.ejs">Services</a></li>
    </ul>

    <div class="icons">
      <!-- <i class="fa-solid fa-heart"></i>
      <i class="fa-solid fa-cart-shopping"></i> -->
    <button onclick="window.location.href='Login.ejs'" style="background: none; border: none; cursor: pointer;">
          <i class="fa-solid fa-user"></i>
      </button>
    </div>
  </nav>

  <div class="review">
    <h1>Customer's <span>Review</span></h1>

    <!-- ✅ Form to Add Review -->
    <div class="review_form" style="margin-bottom: 30px;">
      <form action="/userReview" method="POST" style="display: flex; flex-direction: column; gap: 10px; max-width: 500px; margin: auto;">
        <textarea name="review" placeholder="Write your review here..." rows="4" required style="padding: 10px;"></textarea>
        <button type="submit" style="padding: 10px; background: #333; color: #fff; cursor: pointer;">Submit Review</button>
      </form>
    </div>

    <div class="review_box">
      <% if (reviews && reviews.length > 0) { %>
        <% reviews.forEach(r => { %>
          <div class="review_card">
            <div class="card_top">
              <div class="profile">
                
                <div class="name">
                  <strong> Name: <%= r.userName %></strong>
                  <div class="like">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-regular fa-star"></i>
                  </div>
                </div>
              </div>
            </div>
            <div class="comment">
              <p><%= r.review %></p>
              <small><%= r.curDate %></small>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="text-align: center;">No reviews yet. Be the first to add one!</p>
      <% } %>
    </div>
  </div>
</body>
</html>
