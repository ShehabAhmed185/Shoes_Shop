<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Invoice</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .invoice-container {
      max-width: 800px;
      margin: auto;
      background: #fff;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }
    table, th, td {
      border: 1px solid #ddd;
    }
    th, td {
      padding: 10px;
      text-align: center;
    }
    th {
      background: #f4f4f4;
    }
  </style>
</head>
<body>

  <section class="invoice-container">
    <h1>Your Invoice</h1>

    <p><strong>Date:</strong> <%= order.date %></p>
    <p><strong>Shipping Location:</strong> <%= order.location %></p>
    <p><strong>Phone Number:</strong> <%= order.phone %></p>

    <h3 style="margin-top:20px;">Items:</h3>
    <table>
      <thead>
        <tr>
          <th>Product Name</th>
          <th>Price (per unit)</th>
          <th>Quantity</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% for (let i = 0; i < order.nameOfPro.length; i++) { %>
          <tr>
            <td><%= order.nameOfPro[i] %></td>
            <td>$<%= order.priceOfPro[i].toFixed(2) %></td>
            <td><%= order.userQuan[i] %></td>
            <td>$<%= (order.priceOfPro[i] * order.userQuan[i]).toFixed(2) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <p style="margin-top: 15px; font-size: 18px;">
      <strong>Total Price:</strong> $<%= order.total.toFixed(2) %>
    </p>

    <a href="/Products.ejs" class="btn" style="margin-top: 20px; display: inline-block;">⬅ Back to Products</a>
  </section>

</body>
</html>
